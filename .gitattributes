# Normalize all text files to LF in the repo; working tree stays native.
* text=auto eol=lf

# Explicit text formats (guards against future detection misses).
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.ps1 text eol=lf

# Windows launchers must keep CRLF for cmd.exe.
*.bat text eol=crlf

# Binary assets -- never normalize.
*.png binary
*.xlsx binary
